---
import Plus from '@phosphor-icons/core/assets/regular/plus.svg';
import { FAQ } from '../data/sushiber';
---

<section id="preguntas" aria-labelledby="faq-title" class="px-4 py-24 md:px-8">
  <div class="mx-auto max-w-3xl">
    <div data-reveal>
      <p class="text-sm text-teja">Preguntas frecuentes</p>
      <h2 id="faq-title" class="mt-3 text-4xl md:text-5xl">Antes de venir</h2>
    </div>

    <div class="mt-8 flex flex-col gap-2">
      {
        FAQ.map((item) => (
          <details class="group rounded-3xl border border-crema/10 transition-colors duration-700 ease-fluid open:bg-crema/[0.03]" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-3xl p-6 text-base font-medium transition-colors duration-700 ease-fluid hover:text-teja [&::-webkit-details-marker]:hidden">
              {item.q}
              <Plus class="size-5 shrink-0 text-teja transition-transform duration-700 ease-fluid group-open:rotate-45" aria-hidden="true" />
            </summary>
            <p class="px-6 pb-6 text-base text-crema-suave">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
