---
import { getImage } from 'astro:assets';
import ArrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import WhatsappLogo from '@phosphor-icons/core/assets/regular/whatsapp-logo.svg';
import parada1 from '../assets/world/parada-1.jpg';
import parada2 from '../assets/world/parada-2.jpg';
import parada3 from '../assets/world/parada-3.jpg';
import parada4 from '../assets/world/parada-4.jpg';
import parada5 from '../assets/world/parada-5.jpg';
import parada1m from '../assets/world/parada-1-movil.jpg';
import parada2m from '../assets/world/parada-2-movil.jpg';
import parada3m from '../assets/world/parada-3-movil.jpg';
import parada4m from '../assets/world/parada-4-movil.jpg';
import parada5m from '../assets/world/parada-5-movil.jpg';
import { CONTACT, LINKS } from '../data/sushiber';

// Motor scroll-world: cada parada es una escena fija (fotograma clave de una foto real) y
// los 4 clips son los conectores entre paradas. Los pósters se extraen de esos mismos
// conectores, así cada costura coincide con el vídeo.
const paradas = [
  { id: 'llegada', label: 'Llegada', desktop: parada1, mobile: parada1m, scroll: 1.2 },
  { id: 'barra', label: 'La barra', desktop: parada2, mobile: parada2m, scroll: 1 },
  { id: 'sala', label: 'La sala', desktop: parada3, mobile: parada3m, scroll: 1 },
  { id: 'comedor', label: 'El comedor', desktop: parada4, mobile: parada4m, scroll: 1.1 },
  { id: 'cocina', label: 'La cocina', desktop: parada5, mobile: parada5m, scroll: 1.2 },
];

const sections = await Promise.all(
  paradas.map(async (p) => ({
    id: p.id,
    label: p.label,
    scroll: p.scroll,
    template: `sw-copy-${p.id}`,
    still: (await getImage({ src: p.desktop, width: 1920, format: 'webp', quality: 85 })).src,
    stillMobile: (await getImage({ src: p.mobile, width: 720, format: 'webp', quality: 85 })).src,
  })),
);

const config = {
  sections,
  connectors: [1, 2, 3, 4].map((n) => `/videos/world/conector-${n}.mp4`),
  connectorsMobile: [1, 2, 3, 4].map((n) => `/videos/world/conector-${n}-movil.mp4`),
  diveScroll: 1,
  connScroll: 1.4,
  crossfade: 0.08,
  hint: 'Desliza para recorrer el restaurante',
  nav: false,
  atmosphere: false,
  stillMotion: false,
};

const total = String(paradas.length).padStart(2, '0');
const counter = (i: number) => `${String(i + 1).padStart(2, '0')} / ${total}`;
---

<section id="recorrido" aria-label="Recorrido por el restaurante" data-world data-config={JSON.stringify(config)}></section>

<!-- 01 · Llegada (hero) -->
<template id="sw-copy-llegada">
  <p class="text-xs tracking-[0.14em] text-crema-suave uppercase">
    {counter(0)} <span class="text-teja">•</span> Llegada
  </p>
  <p class="mt-4 text-sm text-crema-suave">{CONTACT.street} · {CONTACT.city}</p>
  <h1 class="mt-4 bg-linear-to-r from-crema to-crema-tenue bg-clip-text text-5xl text-transparent md:text-7xl">
    Cocina japonesa fusión<br class="hidden md:inline" /> en Dénia
  </h1>
  <p class="mt-6 text-base text-crema-suave md:text-lg">
    Sushi creativo que une Japón con sabores mediterráneos y peruanos, elaborado de forma artesanal y al momento.
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-6">
    <a
      href={LINKS.reservar}
      class="rounded-full bg-teja px-3 py-2 text-base font-medium text-tinta transition-all duration-700 ease-fluid hover:scale-[1.03] hover:bg-teja-claro active:scale-[0.98]"
    >
      Reservar mesa
    </a>
    <p class="text-sm text-crema-suave">En Dénia desde 2018</p>
  </div>
</template>

<!-- 02 · La barra: cifra destacada -->
<template id="sw-copy-barra">
  <p class="text-xs tracking-[0.14em] text-crema-suave uppercase">
    {counter(1)} <span class="text-teja">•</span> La barra
  </p>
  <p class="mt-4 text-sm tracking-[0.14em] text-teja uppercase">Bienvenida</p>
  <h2 class="mt-4 text-4xl md:text-6xl">Luz cálida al entrar</h2>
  <p class="mt-4 text-base text-crema-suave md:text-lg">
    Te recibe una barra iluminada desde abajo, con las botellas y las copas a la vista.
  </p>
  <div class="mt-8 flex items-center gap-6">
    <p class="font-display text-7xl text-teja md:text-8xl">2018</p>
    <p class="max-w-48 text-sm text-crema-suave">Abrimos nuestras puertas en Dénia un 10 de marzo.</p>
  </div>
</template>

<!-- 03 · La sala: dos tarjetas -->
<template id="sw-copy-sala">
  <p class="text-xs tracking-[0.14em] text-crema-suave uppercase">
    {counter(2)} <span class="text-teja">•</span> La sala
  </p>
  <p class="mt-4 text-sm tracking-[0.14em] text-teja uppercase">Nuestra propuesta</p>
  <h2 class="mt-4 text-4xl md:text-6xl">Japón, con acento mediterráneo y peruano</h2>
  <p class="mt-4 text-base text-crema-suave md:text-lg">
    Partimos de la cocina japonesa y la cruzamos con sabores mediterráneos y peruanos.
  </p>
  <ul class="mt-8 grid grid-cols-2 gap-4">
    <li class="rounded-2xl border border-crema/15 p-4 md:p-6">
      <p class="font-display text-xl md:text-3xl">Leche de tigre</p>
      <p class="mt-2 text-sm text-crema-suave">Marina el atún de nuestro Acevichado roll</p>
    </li>
    <li class="rounded-2xl border border-crema/15 p-4 md:p-6">
      <p class="font-display text-xl md:text-3xl">Ají amarillo</p>
      <p class="mt-2 text-sm text-crema-suave">En la crema del Japan in Perú</p>
    </li>
  </ul>
</template>

<!-- 04 · El comedor: pasos numerados -->
<template id="sw-copy-comedor">
  <p class="text-xs tracking-[0.14em] text-crema-suave uppercase">
    {counter(3)} <span class="text-teja">•</span> El comedor
  </p>
  <p class="mt-4 text-sm tracking-[0.14em] text-teja uppercase">Reservas</p>
  <h2 class="mt-4 text-4xl md:text-6xl">Tu mesa, para dos o para el grupo</h2>
  <ol class="mt-6 flex flex-col gap-4">
    <li class="flex gap-4">
      <span class="font-display text-3xl text-teja">1</span>
      <div>
        <p class="font-display text-xl">Reserva online</p>
        <p class="mt-1 text-sm text-crema-suave">Elige día y hora en nuestro sistema de reservas.</p>
      </div>
    </li>
    <li class="flex gap-4">
      <span class="font-display text-3xl text-teja">2</span>
      <div>
        <p class="font-display text-xl">Más de {CONTACT.groupThreshold} personas</p>
        <p class="mt-1 text-sm text-crema-suave">
          Reserva por teléfono en el{' '}
          <a
            href={CONTACT.phoneHref}
            class="text-crema underline decoration-teja underline-offset-4 transition-colors duration-700 ease-fluid hover:text-teja"
          >
            {CONTACT.phoneDisplay}
          </a>.
        </p>
      </div>
    </li>
  </ol>
  <a
    href={LINKS.whatsapp}
    class="mt-6 hidden w-max items-center gap-2 rounded-full border border-teja/60 px-4 py-2 text-sm text-teja transition-colors duration-700 ease-fluid hover:border-teja hover:bg-teja/10 md:inline-flex"
  >
    <WhatsappLogo class="size-4" aria-hidden="true" />
    ¿Dudas antes de reservar? Escríbenos por WhatsApp
  </a>
  <div class="mt-6">
    <a
      href={LINKS.reservar}
      class="inline-block rounded-full bg-teja px-3 py-2 text-base font-medium text-tinta transition-all duration-700 ease-fluid hover:scale-[1.03] hover:bg-teja-claro active:scale-[0.98]"
    >
      Reservar mesa
    </a>
  </div>
</template>

<!-- 05 · La cocina: trío de valores -->
<template id="sw-copy-cocina">
  <p class="text-xs tracking-[0.14em] text-crema-suave uppercase">
    {counter(4)} <span class="text-teja">•</span> La cocina
  </p>
  <p class="mt-4 text-sm tracking-[0.14em] text-teja uppercase">Elaboración</p>
  <h2 class="mt-4 text-4xl md:text-6xl">Preparado al momento</h2>
  <p class="mt-4 text-base text-crema-suave md:text-lg">
    Elaboramos cada plato de forma artesanal, cuidando lo que más importa.
  </p>
  <p class="mt-8 flex flex-wrap items-baseline gap-x-4 gap-y-2 font-display text-3xl md:text-5xl">
    <span>Producto</span><span class="text-teja" aria-hidden="true">·</span>
    <span>Sabor</span><span class="text-teja" aria-hidden="true">·</span>
    <span>Textura</span>
  </p>
  <a
    href="#carta"
    class="mt-8 inline-flex items-center gap-2 text-base font-medium text-crema transition-colors duration-700 ease-fluid hover:text-teja"
  >
    Ver platos de la carta
    <ArrowRight class="size-4" aria-hidden="true" />
  </a>
</template>

<script>
  import { initWorld } from '../scripts/world';
  initWorld();
</script>
