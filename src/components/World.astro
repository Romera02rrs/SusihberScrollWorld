---
import { getImage } from 'astro:assets';
import ArrowDown from '@phosphor-icons/core/assets/regular/arrow-down.svg';
import ArrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import parada1 from '../assets/world/parada-1.jpg';
import parada2 from '../assets/world/parada-2.jpg';
import parada3 from '../assets/world/parada-3.jpg';
import parada4 from '../assets/world/parada-4.jpg';
import parada5 from '../assets/world/parada-5.jpg';
import parada1m from '../assets/world/parada-1-movil.jpg';
import parada2m from '../assets/world/parada-2-movil.jpg';
import parada3m from '../assets/world/parada-3-movil.jpg';
import parada4m from '../assets/world/parada-4-movil.jpg';
import parada5m from '../assets/world/parada-5-movil.jpg';
import { CONTACT, LINKS } from '../data/sushiber';

// Cada parada coincide con el fotograma clave de una foto real del local.
// El vídeo son 4 tramos de 5,1667 s concatenados (20,67 s en total).
const SEGMENT = 5.1667;

const stops = [
  { id: 'llegada', label: 'Llegada', desktop: parada1, mobile: parada1m, alt: 'Fachada de Sushiber de noche, con el rótulo iluminado sobre la entrada' },
  { id: 'barra', label: 'La barra', desktop: parada2, mobile: parada2m, alt: 'Barra de Sushiber iluminada desde abajo, con botellas y copas a la vista' },
  { id: 'sala', label: 'La sala', desktop: parada3, mobile: parada3m, alt: 'Entrada a la sala bajo un noren azul con caligrafía japonesa' },
  { id: 'comedor', label: 'El comedor', desktop: parada4, mobile: parada4m, alt: 'Comedor con mesas redondas de madera y una hornacina en arco iluminada en rojo' },
  { id: 'cocina', label: 'La cocina', desktop: parada5, mobile: parada5m, alt: 'Barra de cocina con estanterías de cerámica y luz cálida' },
].map((stop, i) => ({ ...stop, time: Math.min(i * SEGMENT, 20.62) }));

const posters = await Promise.all(
  stops.map(async (stop) => ({
    desktop: await getImage({ src: stop.desktop, width: 1920, format: 'webp', quality: 72 }),
    mobile: await getImage({ src: stop.mobile, width: 720, format: 'webp', quality: 72 }),
  })),
);

const card = 'rounded-3xl border border-crema/10 bg-tinta/75 p-6 backdrop-blur-md md:p-8';
---

<section id="recorrido" aria-label="Recorrido por el restaurante" class="relative" data-world>
  <!-- Escenario fijo: vídeo de fondo controlado por el scroll -->
  <div class="sticky top-0 h-svh w-full overflow-hidden" data-world-stage aria-hidden="true">
    {
      stops.map((stop, i) => (
        <picture
          class:list={[
            'absolute inset-0 transition-opacity duration-700 ease-fluid',
            i === 0 ? 'opacity-100' : 'opacity-0',
          ]}
          data-poster={i}
        >
          <source media="(max-aspect-ratio: 1/1)" srcset={posters[i].mobile.src} />
          <img
            src={posters[i].desktop.src}
            alt=""
            class="size-full object-cover"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </picture>
      ))
    }

    <video
      data-world-video
      data-src="/videos/world/recorrido-1080.mp4"
      data-src-mobile="/videos/world/recorrido-movil-720.mp4"
      class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-700 ease-fluid"
      muted
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"
    ></video>

    <div class="absolute inset-0 bg-tinta/30"></div>

    <!-- Indicador del recorrido -->
    <ol class="absolute top-1/2 right-6 hidden -translate-y-1/2 flex-col gap-4 lg:flex">
      {
        stops.map((stop, i) => (
          <li class="group flex items-center justify-end gap-3" data-rail={i}>
            <span class="text-xs text-crema-suave opacity-0 transition-opacity duration-700 ease-fluid group-data-active:opacity-100">
              {stop.label}
            </span>
            <span class="size-2 rounded-full bg-crema/30 transition-all duration-700 ease-fluid group-data-active:scale-150 group-data-active:bg-teja" />
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Paradas: el texto se mantiene fijo mientras el vídeo avanza entre ellas -->
  <div class="relative -mt-[100svh]" id="contenido">
    {/* 1 · Llegada (hero) */}
    <article id="top" class="relative h-[150svh]" data-stop="0" data-time={stops[0].time} aria-labelledby="hero-title">
      <div class="sticky top-0 flex h-svh items-end px-4 pb-6 md:items-center md:px-16 md:pb-0">
        <div class:list={[card, 'max-w-[680px]']} data-stop-card>
          <p class="text-sm text-crema-suave">
            {CONTACT.street} · {CONTACT.city}
          </p>
          <h1
            id="hero-title"
            class="mt-4 bg-linear-to-r from-crema to-crema-tenue bg-clip-text text-5xl text-transparent md:text-7xl"
          >
            Cocina japonesa fusión<br class="hidden md:inline" /> en Dénia
          </h1>
          <p class="mt-6 max-w-[680px] text-base text-crema-suave md:text-lg">
            Sushi creativo que une Japón con sabores mediterráneos y peruanos, elaborado de forma artesanal y al momento.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-6">
            <a
              href={LINKS.reservar}
              class="rounded-full bg-teja px-3 py-2 text-base font-medium text-tinta transition-all duration-700 ease-fluid hover:scale-[1.03] hover:bg-teja-claro active:scale-[0.98]"
            >
              Reservar mesa
            </a>
            <p class="text-sm text-crema-suave">En Dénia desde 2018</p>
          </div>
        </div>
      </div>
      <a
        href="#barra"
        class="absolute top-[calc(100svh-4rem)] left-1/2 hidden -translate-x-1/2 items-center gap-2 text-sm text-crema-suave transition-colors duration-700 ease-fluid hover:text-crema md:flex"
      >
        Desliza para recorrer el restaurante
        <ArrowDown class="size-4" aria-hidden="true" />
      </a>
    </article>

    {/* 2 · La barra */}
    <article id="barra" class="h-[150svh]" data-stop="1" data-time={stops[1].time} aria-labelledby="barra-title">
      <div class="sticky top-0 flex h-svh items-end px-4 pb-6 md:items-center md:px-16 md:pb-0">
        <div class:list={[card, 'max-w-xl']} data-stop-card>
          <p class="text-sm text-teja">La barra</p>
          <h2 id="barra-title" class="mt-3 text-3xl md:text-5xl">Luz cálida al entrar</h2>
          <p class="mt-4 text-base text-crema-suave">
            Te recibe una barra iluminada desde abajo, con las botellas y las copas a la vista.
          </p>
        </div>
      </div>
    </article>

    {/* 3 · La sala */}
    <article id="sala" class="h-[150svh]" data-stop="2" data-time={stops[2].time} aria-labelledby="sala-title">
      <div class="sticky top-0 flex h-svh items-end px-4 pb-6 md:items-center md:px-16 md:pb-0">
        <div class:list={[card, 'max-w-xl']} data-stop-card>
          <p class="text-sm text-teja">La sala</p>
          <h2 id="sala-title" class="mt-3 text-3xl md:text-5xl">Japón, con acento mediterráneo y peruano</h2>
          <p class="mt-4 text-base text-crema-suave">
            Partimos de la cocina japonesa y la cruzamos con sabores mediterráneos y peruanos: sushi atrevido, innovador y
            detallista.
          </p>
        </div>
      </div>
    </article>

    {/* 4 · El comedor */}
    <article id="comedor" class="h-[150svh]" data-stop="3" data-time={stops[3].time} aria-labelledby="comedor-title">
      <div class="sticky top-0 flex h-svh items-end px-4 pb-6 md:items-center md:px-16 md:pb-0">
        <div class:list={[card, 'max-w-xl']} data-stop-card>
          <p class="text-sm text-teja">El comedor</p>
          <h2 id="comedor-title" class="mt-3 text-3xl md:text-5xl">Reserva para dos o para todo el grupo</h2>
          <p class="mt-4 text-base text-crema-suave">
            Reserva desde la web. Si sois más de {CONTACT.groupThreshold} personas, llámanos al{' '}
            <a href={CONTACT.phoneHref} class="text-crema underline decoration-teja underline-offset-4 transition-colors duration-700 ease-fluid hover:text-teja">
              {CONTACT.phoneDisplay}
            </a>.
          </p>
        </div>
      </div>
    </article>

    {/* 5 · La cocina */}
    <article id="cocina" class="h-[150svh]" data-stop="4" data-time={stops[4].time} aria-labelledby="cocina-title">
      <div class="sticky top-0 flex h-svh items-end px-4 pb-6 md:items-center md:px-16 md:pb-0">
        <div class:list={[card, 'max-w-xl']} data-stop-card>
          <p class="text-sm text-teja">La cocina</p>
          <h2 id="cocina-title" class="mt-3 text-3xl md:text-5xl">Preparado al momento</h2>
          <p class="mt-4 text-base text-crema-suave">
            Elaboramos cada plato de forma artesanal, cuidando el producto, el sabor y el contraste de texturas.
          </p>
          <a
            href="#carta"
            class="mt-6 inline-flex items-center gap-2 text-base font-medium text-crema transition-colors duration-700 ease-fluid hover:text-teja"
          >
            Ver platos de la carta
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  import { initWorld } from '../scripts/world';
  initWorld();
</script>
