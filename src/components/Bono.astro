---
import { Picture } from 'astro:assets';
import Gift from '@phosphor-icons/core/assets/regular/gift.svg';
import fachada from '../assets/photos/01-Fachada.webp';
import { BONO_IMPORTES, CONTACT, LINKS } from '../data/sushiber';
---

<section id="bono" aria-labelledby="bono-title" class="px-4 py-24 md:px-8">
  <div class="mx-auto grid max-w-6xl items-center gap-12 rounded-3xl border border-crema/10 p-6 md:grid-cols-[1fr_auto] md:gap-16 md:p-12">
    <div data-reveal>
      <p class="inline-flex items-center gap-2 text-sm text-teja">
        <Gift class="size-4" aria-hidden="true" />
        Bono regalo
      </p>
      <h2 id="bono-title" class="mt-3 text-4xl md:text-5xl">Regala una mesa en Sushiber</h2>
      <p class="mt-4 max-w-xl text-base text-crema-suave">
        Elige el importe, a quién se lo envías y añade una dedicatoria si quieres. Para canjearlo, se reserva mesa por
        teléfono en el {CONTACT.phoneDisplay}.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Importes disponibles">
        {
          BONO_IMPORTES.map((importe) => (
            <li class="rounded-full border border-crema/15 px-3 py-1 text-sm text-crema-suave">{importe} €</li>
          ))
        }
      </ul>

      <a
        href={LINKS.bono}
        class="mt-8 inline-flex items-center gap-2 rounded-full border border-teja px-3 py-2 text-base font-medium text-crema transition-all duration-700 ease-fluid hover:bg-teja hover:text-tinta active:scale-[0.98]"
      >
        Regalar un bono
      </a>
    </div>

    <div class="mx-auto w-48 overflow-hidden rounded-full md:w-64" data-reveal>
      <Picture
        src={fachada}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[256, 512]}
        sizes="(min-width: 768px) 256px, 192px"
        alt="Fachada de Sushiber de noche, con el rótulo iluminado"
        class="aspect-[1/2] w-full object-cover"
      />
    </div>
  </div>
</section>
