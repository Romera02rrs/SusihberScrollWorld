---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import World from '../components/World.astro';
import Tagline from '../components/Tagline.astro';
import Carta from '../components/Carta.astro';
import Reservar from '../components/Reservar.astro';
import Bono from '../components/Bono.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CONTACT, FAQ, LINKS } from '../data/sushiber';

// Sin horario: pendiente de confirmar con el restaurante.
const restaurant = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'Sushiber',
  url: 'https://sushiber.com',
  servesCuisine: ['Japonesa', 'Fusión'],
  telephone: '+34647617878',
  email: CONTACT.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.street,
    postalCode: CONTACT.postalCode,
    addressLocality: CONTACT.city,
    addressRegion: CONTACT.region,
    addressCountry: 'ES',
  },
  acceptsReservations: LINKS.reservar,
  hasMenu: LINKS.carta,
  sameAs: [LINKS.instagram, LINKS.facebook, LINKS.tripadvisor],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="Sushiber | Cocina japonesa fusión en Dénia"
  description="Sushi creativo con influencias japonesas, mediterráneas y peruanas, elaborado al momento. Reserva tu mesa en Sushiber, Av. Juan Chabás 3, Dénia."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(restaurant)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <SiteHeader />
  <main>
    <World />
    <Tagline />
    <Carta />
    <Reservar />
    <Bono />
    <Faq />
    <Contacto />
  </main>
  <SiteFooter />
</Layout>

<script>
  import { initReveal, initTagline } from '../scripts/reveal';
  initReveal();
  initTagline();
</script>
